# 모두 선택 사항입니다. 키가 없어도 전부 동작합니다 (키 없는 경로를 씀).

# 네이버 검색어 트렌드 (연령·성별) — 키 없으면 datalab.naver.com 웹 경로(비공식, 느림)로 동작
# 키가 있으면 공식 API 가 기본, 웹 경로는 예비로 자동 전환 (docs/SOURCES.md)
#   신규 키: 네이버 클라우드 콘솔 > Services > Application Services > NAVER API HUB > Application 등록 > "검색어 트렌드"
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 비우면 자동 (키 있으면 hub, 없으면 web). 2026-07-31 이전 developers.naver.com 키라면 legacy
NAVER_API=

# YouTube Data API v3 (인기 동영상) — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# 공개 사이트 데이터 암호화 키 (64자리 hex). CI 에서는 저장소 Secret 으로 설정
TREND_ENGINE_DATA_KEY=

# 1 이면 네트워크 대신 tests/fixtures 의 녹화 응답으로 동작 (데모/개발/테스트용)
TREND_ENGINE_OFFLINE=0
TREND_ENGINE_DB=data/trends.db
TREND_ENGINE_ARCHIVE=data/archive
