# 모두 선택 사항입니다. 키가 없으면 해당 소스만 비활성화되고 나머지는 동작합니다.

# 네이버 DataLab (연령/성별 세그먼트) — https://developers.naver.com/apps 에서 "데이터랩(검색어트렌드)" 사용 신청
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YouTube Data API v3 (인기 동영상) — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# 서울 열린데이터광장 (실시간 도시데이터: 핫스팟 연령대별 인구) — https://data.seoul.go.kr
SEOUL_API_KEY=

# Claude (AI 트렌드 브리핑) — pip install 'trend-engine[ai]'
ANTHROPIC_API_KEY=
TREND_ENGINE_AI_MODEL=claude-opus-5

# 1 이면 네트워크 대신 tests/fixtures 의 녹화 응답으로 동작 (데모/개발/테스트용)
TREND_ENGINE_OFFLINE=0
TREND_ENGINE_DB=data/trends.db
